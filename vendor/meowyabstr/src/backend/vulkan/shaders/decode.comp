#version 450
layout(local_size_x=8,local_size_y=8) in;
layout(set=0,binding=0) uniform sampler2D source;
layout(set=0,binding=1,std430) writeonly buffer Output {uint pixels[];} outputData;
layout(push_constant) uniform Size {uint width,height;} size;
void main() {
    uvec2 p=gl_GlobalInvocationID.xy;
    if(p.x>=size.width||p.y>=size.height)return;
    outputData.pixels[p.y*size.width+p.x]=packUnorm4x8(texelFetch(source,ivec2(p),0));
}
